# ──────────────────────────────────────────────────────────────────────────────
# HireLens AI — environment variables
# Copy this file to `.env.local` for local development. NEVER commit .env.local.
# On Vercel, set these in Project Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# MiMo API key (REQUIRED for AI features).
# Enables AI-generated recruitment insights, summaries, and analysis.
# Without it the app still works — deterministic matching runs, AI summaries
# are disabled and clearly marked as unavailable in the UI/API responses.
MIMO_API_KEY=

# MiMo API base URL. Defaults to https://api.mimo.ai/v1
# Override if your MiMo provider uses a different endpoint.
MIMO_BASE_URL=

# Optional: override the MiMo model name used for analysis.
MIMO_MODEL=

# Optional: comma-separated fallback models if primary is unavailable.
MIMO_FALLBACK_MODELS=
