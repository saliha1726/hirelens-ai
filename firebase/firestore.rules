rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Profiles ────────────────────────────────────────
    match /profiles/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // ── User-Workspace Links ────────────────────────────
    match /user-workspaces/{uid}/workspaces/{wsId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Workspaces ──────────────────────────────────────
    match /workspaces/{wsId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // Members subcollection
      match /members/{memberUid} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
        allow write: if request.auth != null
          && (
            // Owner can manage all members
            resource.data == null && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
            || get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "admin"
          );
      }

      // Invites subcollection
      match /invites/{inviteId} {
        allow read, write: if request.auth != null
          && (
            // Admin can manage invites
            exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "admin"
            // Or invited user can read their own invite
            || inviteId == request.auth.email
          );
      }

      // Jobs subcollection — workspace members
      match /jobs/{jobId} {
        allow read, create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }

      // Candidates subcollection — workspace members
      match /candidates/{candidateId} {
        allow read, create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }

      // Activity subcollection — workspace members
      match /activity/{activityId} {
        allow read, create: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }

      // Offers subcollection — workspace members
      match /offers/{offerId} {
        allow read, create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }

      // Onboarding subcollection — workspace members
      match /onboarding/{taskId} {
        allow read, create, update, delete: if request.auth != null
          && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
      }
    }
  }
}
