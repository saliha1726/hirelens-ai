rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles
    match /profiles/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    // User-Workspace Links
    match /user-workspaces/{uid}/workspaces/{wsId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Workspaces
    match /workspaces/{wsId} {
      allow read: if request.auth != null
        && (request.auth.uid == wsId
          || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid);

      // Members subcollection
      match /members/{memberUid} {
        allow read: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
        allow create: if request.auth != null
          && memberUid == request.auth.uid;
        allow update, delete: if request.auth != null
          && (
            request.auth.uid == wsId
            || (exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "admin")
          );
      }

      // Invites subcollection
      match /invites/{inviteId} {
        allow read, write: if request.auth != null
          && (
            request.auth.uid == wsId
            || (exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "admin")
            || inviteId == request.auth.email
          );
      }

      // Jobs subcollection
      match /jobs/{jobId} {
        allow read, create, update, delete: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      }

      // Candidates subcollection
      match /candidates/{candidateId} {
        allow read, create, update, delete: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      }

      // Activity subcollection
      match /activity/{activityId} {
        allow read, create: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      }

      // Offers subcollection
      match /offers/{offerId} {
        allow read, create, update, delete: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      }

      // Onboarding subcollection
      match /onboarding/{taskId} {
        allow read, create, update, delete: if request.auth != null
          && (request.auth.uid == wsId
            || exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)));
      }
    }
  }
}
